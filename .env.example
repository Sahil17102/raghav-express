# Keep these values server-side. Never prefix them with NEXT_PUBLIC_ or VITE_.
DELHIVERY_B2C_ENV=staging
DELHIVERY_B2C_API_BASE=https://staging-express.delhivery.com
DELHIVERY_B2C_TOKEN=
DELHIVERY_B2C_PICKUP_LOCATION=
# Delhivery B2B/LTL. Use credentials for automatic 24-hour JWT renewal, or a token for manual operation.
DELHIVERY_B2B_ENV=staging
DELHIVERY_B2B_API_BASE=https://ltl-clients-api-dev.delhivery.com
DELHIVERY_B2B_USERNAME=
DELHIVERY_B2B_PASSWORD=
DELHIVERY_B2B_TOKEN=
# India Post external-customer API (UAT by default).
INDIA_POST_API_BASE=https://test.cept.gov.in
INDIA_POST_USERNAME=
INDIA_POST_PASSWORD=
INDIA_POST_CUSTOMER_ID=
INDIA_POST_CONTRACT_ID=
INDIA_POST_SENDER_NAME=
INDIA_POST_SENDER_COMPANY=
INDIA_POST_SENDER_ADDRESS=
INDIA_POST_SENDER_CITY=
INDIA_POST_SENDER_PINCODE=
INDIA_POST_SENDER_MOBILE=
# Required for non-Sites deployments; send as Authorization: Bearer <value>.
RAGHAV_INTERNAL_API_KEY=
# Backend database connection string. Set this only in local/Render environment variables.
DATABASE_URL=
